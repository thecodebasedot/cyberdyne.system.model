[Unit]
Description=Cyberdyne robot brain
After=network.target dev-ttyUSB0.device

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/cyberdyne.system.model
ExecStart=/home/pi/cyberdyne.system.model/.venv/bin/cyberdyne run -s robot.toml
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Environment=ANTHROPIC_API_KEY=...   (only if [brain] llm = "anthropic")

[Install]
WantedBy=multi-user.target
